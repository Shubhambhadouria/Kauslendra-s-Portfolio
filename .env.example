# Set these in your server environment before starting the project.
# PowerShell: $env:GOOGLE_DRIVE_FOLDER_ID = 'YOUR_FOLDER_ID'
# Do not paste your Google private key into this file or into chat.
GOOGLE_DRIVE_FOLDER_ID=
# Optional; defaults to .vault/google-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=
# Hosting: point both directories at persistent storage, outside dist.
VAULT_DIRECTORY=
CONTACT_STORAGE_DIRECTORY=
# Free hosting: PostgreSQL connection URL (keep secret; use TLS).
DATABASE_URL=
# First startup only. Remove these hosting secrets after successful initialization.
INITIAL_OFFICER_PASSWORD=
INITIAL_VIEWER_PASSWORD=
